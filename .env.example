# ─────────────────────────────────────────────────────────────────────────────
# MNEMOS — Environment template (Phase 0)
# Copy to .env for local development:  cp .env.example .env
# NEVER commit .env. NEVER put real secrets in this file.
# All values below are descriptive placeholders only.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────
APP_ENV=development            # development | staging | production
APP_NAME=mnemos
APP_DEBUG=true                 # false in production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Supabase (managed PostgreSQL platform) ─────────────────────────────
# Create a project at https://supabase.com/dashboard and fill these in.
# Project URL: Settings → API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable / anon key: Settings → API → publishable (anon) key.
# Safe for browser code ONLY when Row Level Security is enforced.
SUPABASE_ANON_KEY=your-publishable-anon-key-here
# Secret / service-role key: Settings → API → secret (service_role) key.
# SERVER-SIDE ONLY. Never expose to browser code. Never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here
# Direct Postgres connection string (for migrations / admin tooling).
# Settings → Database → Connection string (pooler or direct).
# Keep server-side only.
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# ── OpenRouter (model-access & routing layer — NOT a model itself) ─────
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
# Default model identifier (OpenRouter model ID, e.g. "openai/gpt-4o-mini").
# Configurable per agent responsibility — never hardcode in business logic.
OPENROUTER_DEFAULT_MODEL=your-default-model-id-here
OPENROUTER_ORCHESTRATOR_MODEL=your-orchestrator-model-id-here
OPENROUTER_RETRIEVAL_MODEL=your-retrieval-model-id-here
OPENROUTER_MEMORY_MODEL=your-memory-model-id-here
OPENROUTER_VERIFICATION_MODEL=your-verification-model-id-here
# HTTP behaviour for the OpenRouter adapter (bounded, with retries).
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_RETRIES=3
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=MNEMOS

# ── Frontend (Vite — only VITE_-prefixed vars reach the browser) ───────
# These must mirror the values above; they are NOT secrets.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key-here
VITE_API_BASE_URL=http://localhost:8000
